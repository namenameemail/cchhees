@startuml cchhees-data-flow

title cchhees data flow

actor User

rectangle "Edit session" {
  component GameProvider
  database FiguresSlice
  database BoardSlice
  database GameState
  component SliceHistory_F as "figuresHistory"
  component SliceHistory_B as "boardHistory"
}

rectangle "Persistence" {
  component ProjectProvider
  component AssetsProvider
  database IndexedDB_projects as "projects"
  database IndexedDB_assets as "assets"
  component migrateProject
  component migrateInlineAssets
}

User --> GameProvider : click / form edit
GameProvider --> FiguresSlice : figure mutations
GameProvider --> BoardSlice : board mutations
FiguresSlice --> GameState : composeGameState
BoardSlice --> GameState : composeGameState
GameProvider --> SliceHistory_F : push / undo / redo
GameProvider --> SliceHistory_B : push / undo / redo
GameProvider --> ProjectProvider : onPersist (debounced 400ms)
ProjectProvider --> IndexedDB_projects : putProject

User --> AssetsProvider : upload / delete asset
AssetsProvider --> IndexedDB_assets : putAsset / deleteAsset
AssetsProvider --> migrateInlineAssets : on project load
migrateInlineAssets --> IndexedDB_assets : create records
migrateInlineAssets --> ProjectProvider : update gameState

IndexedDB_projects --> migrateProject : getAllProjects
migrateProject --> ProjectProvider : Project[]
ProjectProvider --> GameProvider : initialState + histories
ProjectProvider --> AssetsProvider : currentProject.id

@enduml

@startuml cchhees-state-machine

title cchhees modes

[*] --> Game : default

state Game {
  Game : click empty cell, select
  Game : click other cell, move or capture
}

state FiguresArrange {
  FiguresArrange : select figure in palette
  FiguresArrange : click cell, place or replace
}

state PaintTheBoard {
  PaintTheBoard : click cell, set parameters
  PaintTheBoard : no brush UI in sidebar
}

state PaintTheBoardConnections <<unused>> {
  PaintTheBoardConnections : enum only
}

state Probe <<unused>> {
  Probe : enum only
}

Game --> FiguresArrange : FigureButton click
FiguresArrange --> Game : implicit via setMode

note bottom of Game
  board shrink with out-of-grid figures
  opens ShrinkBoardWarningModal
  confirm -> prune + apply
  cancel -> discard pending params
end note

@enduml

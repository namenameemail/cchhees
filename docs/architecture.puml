@startuml cchhees-architecture

title cchhees architecture

package Entry {
  component index_html as index_html
  component main_tsx as main_tsx
  component app_tsx as app_tsx
  component game_shell as game_shell

  index_html --> main_tsx
  main_tsx --> app_tsx
  app_tsx --> game_shell
}

package UI_Layer {
  component game_layout as game_layout
  component board as board
  component board_cell as board_cell
  component tray as tray
  component history_ui as history_ui
  component figures as figures
  component board_params_form as board_params_form
  component conditions as conditions
  component conn_conditions as conn_conditions
  component form1 as form1
  component form_array as form_array
  component cell_svg as cell_svg
  component conn_svg as conn_svg

  game_shell --> game_layout
  game_layout --> board
  game_layout --> tray
  game_layout --> history_ui
  game_layout --> board_params_form
  game_layout --> conditions
  game_layout --> conn_conditions
  game_layout --> figures

  board --> board_cell
  board --> conn_svg
  board_cell --> cell_svg

  board_params_form --> form1
  conditions --> form_array
  conn_conditions --> form_array
  form_array --> form1
}

package State_Layer {
  component game_provider as game_provider
  component game_context as game_context
  database game_state as game_state
  storage ui_state as ui_state
  component history_stack as history_stack

  game_provider --> game_context
  game_provider --> game_state
  game_provider --> ui_state
  game_provider --> history_stack
}

package Domain_Logic {
  component utils as utils
  component cell_predicates as cell_predicates
  component conn_predicates as conn_predicates
  component constants as constants
}

game_layout --> game_provider : wraps

board_cell ..> game_context : useGameContext
board ..> game_context
tray ..> game_context
history_ui ..> game_context
figures ..> game_context
board_params_form ..> game_context
conditions ..> game_context
conn_conditions ..> game_context

game_provider --> utils
board_cell --> cell_predicates
board --> conn_predicates
board_cell --> constants

note right of game_state
  boardParameters
  cells and tray
  boardConditions
  connectionsConditions
end note

note right of ui_state
  mode
  activeCell
  activeFigure
  brush states
end note

note right of board_cell
  Mode.Game: select then move
  Mode.FiguresArrange: place figure
  Mode.PaintTheBoard: set parameters
end note

note bottom of history_stack
  before and after stacks
  max 100 snapshots
end note

note bottom of conn_predicates
  getConnections(n, m)
  visual only, no move rules
end note

@enduml

@startuml cchhees-component-tree

title cchhees component tree

object "main.tsx" as main
object "App.tsx" as app
object "Game" as game
object "GameProvider" as provider

package "Board Area" {
  object "Board (SVG)" as board
  object "ConnectionSVGGroup" as connSvg
  object "BoardCell" as cell
  object "CellSVGGroup" as cellSvg
  object "Tray" as tray
  object "History" as hist
}

package "Sidebar (tab 0: board)" {
  object "BoardParametersForm" as bpf
  object "Conditions" as cond
  object "ConnectionsConditions" as ccond
}

package "Sidebar (tab 1: figures)" {
  object "Figures" as figs
  object "FigureButton" as fbtn
}

main --> app
app --> game
game --> provider
provider --> board
provider --> tray
provider --> hist
provider --> bpf
provider --> cond
provider --> ccond
provider --> figs

board --> connSvg
board --> cell
cell --> cellSvg
figs --> fbtn

note bottom of provider
  CellParametersForm
  ConnectionParametersForm
  imported but NOT rendered
end note

@enduml

@startuml cchhees-state-machine

title cchhees modes

[*] --> Game : default

state Game {
  Game : click empty cell, select
  Game : click other cell, move or capture
}

state FiguresArrange {
  FiguresArrange : select figure in palette
  FiguresArrange : click cell, place or replace
}

state PaintTheBoard {
  PaintTheBoard : click cell, set parameters
  PaintTheBoard : no brush UI in sidebar
}

state PaintTheBoardConnections <<unused>> {
  PaintTheBoardConnections : enum only
}

state Probe <<unused>> {
  Probe : enum only
}

state PaintTheBoardConnections <<unused>> {
  PaintTheBoardConnections : enum only
}

state Probe <<unused>> {
  Probe : enum only
}

Game --> FiguresArrange : FigureButton click
FiguresArrange --> Game : implicit via setMode

@enduml

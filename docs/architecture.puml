@startuml cchhees-architecture

title cchhees architecture

package Entry {
  component index_html as index_html
  component main_tsx as main_tsx
  component app_tsx as app_tsx

  index_html --> main_tsx
  main_tsx --> app_tsx
}

package Persistence_Layer {
  component project_provider as project_provider
  component project_context as project_context
  component assets_provider as assets_provider
  database indexed_db as indexed_db
  database assets_store as assets_store
  component migrate_project as migrate_project
  component migrate_inline_assets as migrate_inline_assets
  component top_bar as top_bar
  component projects_modal as projects_modal

  project_provider --> project_context
  project_provider --> indexed_db
  assets_provider --> assets_store
  assets_provider --> indexed_db
  project_provider --> migrate_project
  assets_provider --> migrate_inline_assets
  app_tsx --> project_provider
  app_tsx --> assets_provider
  project_provider --> top_bar
  project_provider --> projects_modal
}

package UI_Layer {
  component game_shell as game_shell
  component board as board
  component board_cell as board_cell
  component tray as tray
  component figures_history as figures_history
  component board_history as board_history
  component figures as figures
  component board_params_form as board_params_form
  component conditions as conditions
  component conn_conditions as conn_conditions
  component assets_panel as assets_panel
  component image_select as image_select
  component shrink_modal as shrink_modal
  component form1 as form1
  component form_array as form_array
  component cell_svg as cell_svg
  component conn_svg as conn_svg

  project_provider --> game_shell
  assets_provider --> game_shell
  game_shell --> board
  game_shell --> tray
  game_shell --> figures_history
  game_shell --> board_history
  game_shell --> board_params_form
  game_shell --> conditions
  game_shell --> conn_conditions
  game_shell --> figures
  game_shell --> assets_panel

  assets_panel --> assets_provider
  image_select --> assets_provider

  board --> board_cell
  board --> conn_svg
  board_cell --> cell_svg

  board_params_form --> form1
  conditions --> form_array
  conn_conditions --> form_array
  form_array --> form1
}

package State_Layer {
  component game_provider as game_provider
  component game_context as game_context
  database figures_slice as figures_slice
  database board_slice as board_slice
  database composed_state as composed_state
  storage ui_state as ui_state
  component figures_history_stack as figures_history_stack
  component board_history_stack as board_history_stack

  game_shell --> game_provider : wraps
  game_provider --> game_context
  game_provider --> figures_slice
  game_provider --> board_slice
  game_provider --> composed_state
  game_provider --> ui_state
  game_provider --> figures_history_stack
  game_provider --> board_history_stack
  game_provider --> shrink_modal
}

package Domain_Logic {
  component slices as slices
  component reconcile as reconcile
  component migrate as migrate
  component coords as coords
  component utils as utils
  component cell_predicates as cell_predicates
  component conn_predicates as conn_predicates
  component constants as constants
}

game_provider --> slices : split / compose
game_provider --> reconcile : prune on grid change
game_provider --> coords
migrate_project --> migrate
migrate_project --> slices

board_cell ..> game_context : useGameContext
board ..> game_context
tray ..> game_context
figures_history ..> game_context
board_history ..> game_context
figures ..> game_context
board_params_form ..> game_context
conditions ..> game_context
conn_conditions ..> game_context
conditions --> image_select
cell_svg --> assets_provider : resolve assetId

board_cell --> cell_predicates
board --> conn_predicates
board_cell --> constants
board_cell --> coords

game_provider --> project_context : onPersist
migrate_project <-- indexed_db : load

note right of figures_slice
  figuresByCoord
  tray
end note

note right of board_slice
  boardParameters
  boardConditions
  connectionsConditions
  cellParametersByCoord
end note

note right of composed_state
  flat GameState view
  cells[] + tray
  for UI rendering
end note

note right of ui_state
  mode
  activeCell (CellCoord)
  activeFigure
  brush states
  shrink warning state
end note

note bottom of figures_history_stack
  SliceHistory<FiguresSlice>
  before / after stacks
  max 100 snapshots
end note

note bottom of board_history_stack
  SliceHistory<BoardSlice>
  independent undo/redo
  max 100 snapshots
end note

note bottom of assets_store
  project-scoped blobs
  id, projectId, name, mimeType
  outside slice history
end note

note bottom of migrate_inline_assets
  legacy svg file data URLs
  -> assets store + assetId
  at project load
end note

note bottom of migrate
  index-keyed maps
  -> coord-keyed maps
  at project load
end note

note bottom of conn_predicates
  getConnections(n, m)
  visual only, no move rules
end note

note bottom of board_cell
  Mode.Game: select then move
  Mode.FiguresArrange: place figure
  Mode.PaintTheBoard: set parameters
end note

@enduml


#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

DEFAULT_PORT=5173
DEFAULT_SIGNALING_PORT=8787

usage() {
    cat <<'EOF'
Usage: ./run [port]
       ./run --port <port>
       ./run -p <port>
       ./run --signaling-port <port>

Starts the signaling server (default: 8787) and the Vite dev server (default: 5173).
If a port is busy, shows which process holds it and prompts for another port.
Sets VITE_SIGNALING_URL for the frontend automatically.
EOF
}

is_port_in_use() {
    local port=$1

    if command -v ss >/dev/null 2>&1; then
        ss -ltnH "sport = :${port}" 2>/dev/null | grep -q .
        return
    fi

    if command -v lsof >/dev/null 2>&1; then
        lsof -iTCP:"${port}" -sTCP:LISTEN -t >/dev/null 2>&1
        return
    fi

    (echo >/dev/tcp/127.0.0.1/"${port}") 2>/dev/null
}

describe_port_process() {
    local port=$1
    local pid cmd

    if command -v lsof >/dev/null 2>&1; then
        pid=$(lsof -t -iTCP:"${port}" -sTCP:LISTEN 2>/dev/null | head -1 || true)
    elif command -v fuser >/dev/null 2>&1; then
        pid=$(fuser "${port}/tcp" 2>/dev/null | tr -d ' ' || true)
    fi

    if [[ -n "${pid:-}" ]]; then
        cmd=$(ps -p "$pid" -o args= 2>/dev/null || echo "unknown process")
        echo "Port ${port} is in use by PID ${pid}: ${cmd}"
    else
        echo "Port ${port} is in use."
    fi
}

find_next_free_port() {
    local port=$1

    while is_port_in_use "$port"; do
        port=$((port + 1))
        if (( port > 65535 )); then
            echo "No free ports found above ${1}." >&2
            exit 1
        fi
    done

    echo "$port"
}

prompt_for_port() {
    local port=$1
    local suggested next

    while is_port_in_use "$port"; do
        describe_port_process "$port" >&2
        suggested=$(find_next_free_port $((port + 1)))

        if [[ ! -t 0 ]]; then
            echo "Port ${port} is busy. Run interactively or pass a free port." >&2
            exit 1
        fi

        read -r -p "Enter another port [${suggested}]: " next
        next=${next:-$suggested}

        if ! [[ "$next" =~ ^[0-9]+$ ]] || (( next < 1 || next > 65535 )); then
            echo "Invalid port: ${next}" >&2
            continue
        fi

        port=$next
    done

    echo "$port"
}

parse_args() {
    local vite_port=$DEFAULT_PORT
    local signaling_port=$DEFAULT_SIGNALING_PORT

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                usage
                exit 0
                ;;
            -p|--port)
                if [[ $# -lt 2 ]] || ! [[ "$2" =~ ^[0-9]+$ ]]; then
                    usage >&2
                    exit 1
                fi
                vite_port=$2
                shift 2
                ;;
            --signaling-port)
                if [[ $# -lt 2 ]] || ! [[ "$2" =~ ^[0-9]+$ ]]; then
                    usage >&2
                    exit 1
                fi
                signaling_port=$2
                shift 2
                ;;
            *)
                if [[ "$1" =~ ^[0-9]+$ ]]; then
                    vite_port=$1
                    shift
                else
                    usage >&2
                    exit 1
                fi
                ;;
        esac
    done

    if (( vite_port < 1 || vite_port > 65535 || signaling_port < 1 || signaling_port > 65535 )); then
        echo "Invalid port." >&2
        exit 1
    fi

    echo "${vite_port} ${signaling_port}"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

read -r vite_port signaling_port <<< "$(parse_args "$@")"
vite_port=$(prompt_for_port "$vite_port")

if is_port_in_use "$signaling_port"; then
    echo "Signaling port ${signaling_port} is busy." >&2
    describe_port_process "$signaling_port" >&2
    signaling_port=$(find_next_free_port $((signaling_port + 1)))
    echo "Using signaling port ${signaling_port} instead." >&2
fi

signaling_pid=

cleanup() {
    if [[ -n "${signaling_pid:-}" ]]; then
        kill "$signaling_pid" 2>/dev/null || true
    fi
}

trap cleanup EXIT INT TERM

if [[ ! -d signaling-server/node_modules ]]; then
    echo "Installing signaling-server dependencies..."
    npm --prefix signaling-server install
fi

echo "Starting signaling server on port ${signaling_port}..."
PORT="$signaling_port" npm --prefix signaling-server run start &
signaling_pid=$!

export VITE_SIGNALING_URL="ws://127.0.0.1:${signaling_port}"

echo "Starting dev server on port ${vite_port}..."
echo "VITE_SIGNALING_URL=${VITE_SIGNALING_URL}"
npm run dev -- --port "$vite_port" --strictPort
